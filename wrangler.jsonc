{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "past-paper-zone",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PAST_PAPERS_BUCKET",
      "bucket_name": "past-papers"
    }
  ],
  "routes": [
    { "pattern": "pastpaperzone.lk", "custom_domain": true },
    { "pattern": "www.pastpaperzone.lk", "custom_domain": true },
    { "pattern": "admin.pastpaperzone.lk", "custom_domain": true }
  ]
}
