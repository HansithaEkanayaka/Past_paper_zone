{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "past-paper-zone",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "pastpaperzone.lk", "custom_domain": true },
    { "pattern": "www.pastpaperzone.lk", "custom_domain": true }
  ]
}
