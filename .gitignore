# Environment Variables (සූක්ෂම තොරතුරු සහ API Keys)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies (විශාල libraries - package.json එකෙන් නැවත install කරගත හැක)
/node_modules
/.pnpm-store

# Next.js Build Outputs
/.next/
/out/

# Production Build Files
/build
/dist

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel (Next.js Deployment Configs)
.vercel

# TypeScript Cache
*.tsbuildinfo
next-env.d.ts

# Editor / OS specific files
.vscode/
.idea/
.DS_Store
Thumbs.db